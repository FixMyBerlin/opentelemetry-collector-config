# Kopieren nach .env und Werte eintragen. Die .env gehört nicht ins Repo.

# Feste Service-Instanz-ID – verhindert, dass sich die ID bei jedem Neustart ändert.
# Beliebigen stabilen Wert setzen, z. B. Hostname oder UUID.
OTEL_SERVICE_INSTANCE_ID=SERVICE-ID-HERE

# OneUptime Ingest-Token – projektweit eindeutig, in der OneUptime-Projektverwaltung zu finden.
ONEUPTIME_TOKEN=YOUR-SECRET-HERE

# Optional: Adresse, an die die OTLP-Ports gebunden werden (Standard: 127.0.0.1)
# OTEL_BIND_ADDRESS=0.0.0.0
